# Скопируйте этот файл в .env для локальной разработки с общим доступом (клубами).
# Оба значения — из Supabase: Settings -> API.
# VITE_SUPABASE_ANON_KEY — это публичный ключ "anon public", его можно спокойно
# использовать в клиентском коде. Никогда не используйте здесь "service_role".
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=
